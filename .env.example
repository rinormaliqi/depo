# ─── SmartDepo environment ──────────────────────────────────────────────
# Copy to .env for local dev. In production (Vercel / Render) set these in
# the dashboard — never commit .env.
#
#   REQUIRED  = the app won't start / a core flow breaks without it
#   OPTIONAL  = the feature degrades gracefully when empty (says how)

# ── Database (REQUIRED) ───────────────────────────────────────────────────
# Postgres connection string. Local dev matches docker-compose.yml.
# Production: the URL from Neon / Render Postgres / Supabase (pooler).
# Serverless providers need ?sslmode=require on the end.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartdepo

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────
# Auth.js session-cookie encryption key. Generate with:  openssl rand -base64 33
# Must be the same across all instances; changing it logs everyone out.
AUTH_SECRET=

# ── Operator access (REQUIRED in production) ──────────────────────────────
# Comma-separated emails allowed onto /internal (cross-tenant billing
# console: activate plans, record bank transfers, edit paid-until).
# Empty = nobody can reach /internal.
PLATFORM_ADMIN_EMAILS=

# ── Company identity (OPTIONAL, shown publicly) ───────────────────────────
# Used on /terms, /refunds, /contact and the site footer. Update once the
# business is registered at ARBK. Defaults: "SmartDepo", no reg. no.,
# "Prishtinë, Kosovë".
NEXT_PUBLIC_LEGAL_NAME=SmartDepo
NEXT_PUBLIC_COMPANY_REG_NO=
NEXT_PUBLIC_COMPANY_ADDRESS=Prishtinë, Kosovë
# Shown on /contact, /billing ("prefer bank transfer? email …"), Enterprise
# "contact us", and substituted into the legal text. Empty = those lines
# say "get in touch with whoever set up your account" instead.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Email via Resend (OPTIONAL locally, REQUIRED for real customers) ───────
# Sends: email verification (signup), team invites, password reset,
# "your trial / paid period ends in 7 days" reminders.
# Empty = every email is printed to the server console instead of sent,
# so all flows stay testable (copy the link from the log).
# https://resend.com — free tier.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend before real users:
# the default onboarding@resend.dev only delivers to the Resend account's
# own email.
EMAIL_FROM=SmartDepo <onboarding@resend.dev>

# ── Payments via Paysera Checkout (OPTIONAL until approved) ──────────────
# From Paysera → Projektet dhe aktivitetet → your project → settings.
# Both empty = /billing shows the bank-transfer / contact path only and
# orgs are activated on /internal ("+ Payment").
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
# 1 = send test=1 (no real money; callbacks with test=0 are ignored).
# Keep at 1 until Paysera approves the project for live payments, then 0.
PAYSERA_TEST_MODE=1
# Register this callback URL in the Paysera project:
#   https://<your-domain>/api/billing/paysera/callback
#
# Site-ownership tag from the project's "Konfirmimi i projektit" section:
# for <meta name="X" content="Y"> set NAME=X and VALUE=Y. Empty = no tag.
NEXT_PUBLIC_PAYSERA_VERIFICATION_NAME=
NEXT_PUBLIC_PAYSERA_VERIFICATION_VALUE=
