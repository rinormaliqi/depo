{
  "name": "smartdepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:dev": "tsx src/db/seed-dev.ts",
    "db:seed:large": "tsx src/db/seed-large-floor.ts",
    "test": "node --import tsx --import ./src/test-support/register.mjs --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"src/lib/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.75.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "jsqr": "^1.4.0",
    "next": "^15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.4",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12"
    }
  }
}
