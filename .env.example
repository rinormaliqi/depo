# Local dev: matches docker-compose.yml. Production: Render Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smartdepo

# Auth.js session encryption — generate a real one with `openssl rand -base64 33`
AUTH_SECRET=

# Comma-separated emails allowed onto /internal (manually activating an
# org's plan). Leave empty in any environment where nobody should have that
# access.
PLATFORM_ADMIN_EMAILS=

# Shown on /billing as where a customer can ask about changing their plan.
# Leave empty to hide that line entirely rather than show a dead contact.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Resend API key, used for password-reset emails (and anything else that
# starts sending mail later). Leave empty in dev — emails log to the
# server console instead of sending, so the reset flow stays testable
# without one. https://resend.com — free tier, no separate paid infra.
RESEND_API_KEY=
# Must be on a domain verified in Resend once this is set — the default
# onboarding@resend.dev sender only delivers to the Resend account's own
# verified email, fine for solo testing but not for real users.
EMAIL_FROM=SmartDepo <onboarding@resend.dev>
